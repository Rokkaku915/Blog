{% assign sum = site.posts | size %}

<nav class="nav__list">
    <input id="ac-toc" name="accordion-toc" type="checkbox" />
    <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label }}</label>
    <ul class="nav__items" id="category_tag_menu">
        <!-- 전체 글 수 -->
        <li>
            <span>전체 글 ({{sum}})</span>
        </li>

        <!-- 일본어 카테고리 -->
        <li>
            {% assign nihongo_count = 0 %}
            {% for category in site.categories %}
                {% if category[0] == "kanji" %}
                    {% assign nihongo_count = nihongo_count | plus: category[1].size %}
                {% endif %}
            {% endfor %}
            <span class="nav__sub-title">일본어 ({{nihongo_count}})</span>
            <ul>
                {% for category in site.categories %}
                    {% if category[0] == "kanji" %}
                        <li><a href="/nihongo/kanji" class="">한자 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>

        <!-- 연구 카테고리 -->
        <li>
            {% assign kenkyuu_count = 0 %}
            {% for category in site.categories %}
                {% if category[0] == "kenkyuusei" %}
                    {% assign kenkyuu_count = kenkyuu_count | plus: category[1].size %}
                {% endif %}
            {% endfor %}
            <span class="nav__sub-title">연구 ({{kenkyuu_count}})</span>
            <ul>
                {% for category in site.categories %}
                    {% if category[0] == "kenkyuusei" %}
                        <li><a href="/kenkyuu/kenkyuusei" class="">학부연구생 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>

        <!-- 일상 카테고리 -->
        <li>
            {% assign nichijou_count = 0 %}
            {% for category in site.categories %}
                {% if category[0] == "tabi" or category[0] == "heieki" %}
                    {% assign nichijou_count = nachijou_count | plus: category[1].size %}
                {% endif %}
            {% endfor %}
            <span class="nav__sub-title">일상 ({{nichijou_count}})</span>
            <ul>
                {% for category in site.categories %}
                    {% if category[0] == "tabi" %}
                        <li><a href="/nichijou/tabi" class="">여행 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
            <ul>
                {% for category in site.categories %}
                    {% if category[0] == "heieki" %}
                        <li><a href="/nichijou/heieki" class="">군대 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    </ul>
</nav>