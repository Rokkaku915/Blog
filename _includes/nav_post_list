{% assign sum = site.posts | size %}

<nav class="nav__list">
    <input id="ac-toc" name="accordion-toc" type="checkbox" />
    <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label }}</label>
    <ul class="nav__items" id="category_tag_menu">
        <!-- 전체 글 수 -->
        <li class="nav__home">
            <a href="/" class="nav__home">전체 글 ({{sum}})</span>                               <!-- 어차피 전체 글은 Home가면 보이니깐 Home으로 이동시키기 위해 작성 -->
        </li>                                                                                    <!-- 단, nav__sub-title과는 다른 스타일이 적용되기 때문에 별도의 class인 nav__home으로 작성 -->

        <!-- 일본어 카테고리 -->
        <li>
            {% assign nihongo_count = 0 %}
            {% for category in site.categories %}
                {% if category[0] == "한자" %}
                    {% assign nihongo_count = nihongo_count | plus: category[1].size %}
                {% endif %}
            {% endfor %}
            <a href="/japanese" class="nav__sub-title">일본어 ({{nihongo_count}})</a>            <!-- 일본어, 연구와 같은 전체 카테고리를 nav__sub-title로 묶음 처리 (스타일 변경하기 위함) -->
            <ul class="nav__category">                                                          <!-- 한자, 연구와 같은 세부 카테고리를 nav__category로 묶음 처리 (Category 보기 쉽게 왼쪽에 얇은 회색 선 추가하기 위함) -->
                {% for category in site.categories %}
                    {% if category[0] == "한자" %}
                        <li><a href="/japanese/kanji">한자 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>

        <!-- 연구 카테고리 -->
        <li>
            {% assign kenkyuu_count = 0 %}
            {% for category in site.categories %}
                {% if category[0] == "학부연구생" %}
                    {% assign kenkyuu_count = kenkyuu_count | plus: category[1].size %}
                {% endif %}
            {% endfor %}
            <a href="/research" class="nav__sub-title">연구 ({{kenkyuu_count}})</a>
            <ul class="nav__category">
                {% for category in site.categories %}
                    {% if category[0] == "학부연구생" %}
                        <li><a href="/research/undergraduate_research_student">학부연구생 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>

        <!-- 일상 카테고리 -->
        <li>
            {% assign nichijou_count = 0 %}
            {% for category in site.categories %}
                {% if category[0] == "여행" or category[0] == "군대" %}
                    {% assign nichijou_count = nichijou_count | plus: category[1].size %}
                {% endif %}
            {% endfor %}
            <a href="/daily_life" class="nav__sub-title">일상 ({{nichijou_count}})</a>
            <ul class="nav__category">
                {% for category in site.categories %}
                    {% if category[0] == "여행" %}
                        <li><a href="/daily_life/travel">여행 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            <!-- </ul>
            <ul> -->
                {% for category in site.categories %}
                    {% if category[0] == "군대" %}
                        <li><a href="/daily_life/air_force">군대 ({{category[1].size}})</a></li>
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    </ul>
</nav>